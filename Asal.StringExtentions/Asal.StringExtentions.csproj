<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PackageId>Asal.StringExtentions</PackageId>
    <Version>1.7.0</Version>
    <Title>Asal.StringExtentions</Title>
    <Authors>Hamza Asal</Authors>
    <Company>Hamza Asal</Company>
    <Product>Asal.StringExtentions</Product>
    <Description>A simple package that help you to call some string extentions to make some proccess on the string</Description>
    <PackageTags>String, extentions, Strings, Asal, email, string checker, string extensions, json extract</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/HamzaAl-Asal/Asal.StringExtentions</RepositoryUrl>
    <PackageReleaseNotes>
      Improvements and behavioral adjustments:
      - Introduced centralized compiled RegexPatterns for better performance
      - Improved JSON array extraction to support both primitive and object tokens
      - Fixed nullable warnings in JSON helper methods
      - Code cleanup and reliability improvements

      Behavioral Change:
      - JsonToXml() no longer wraps the result in a default root element automatically.
      Pass a root name explicitly if wrapping is required.
    </PackageReleaseNotes>

    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageIcon>AsalLibraryCroppedLogo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Logo\AsalLibraryCroppedLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Logo\AsalLibraryCroppedLogo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="YamlDotNet.NetCore" Version="1.0.0" />
  </ItemGroup>

</Project>
